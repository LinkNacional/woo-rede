#. Plugin Name of the plugin
#: integration-rede-for-woocommerce.php
msgid "Integration Rede Itaú for WooCommerce — Payment PIX, Credit Card and Debit"
msgstr "Integração da Rede para WooCommerce"

#. Description of the plugin
#: integration-rede-for-woocommerce.php
msgid "Receive payments with credit and debit cards from different brands, using 3DS authentication and advanced fraud protection features."
msgstr "Receba pagamentos com cartões de crédito e débito de diferentes bandeiras, usando autenticação 3DS e recursos avançados de proteção contra fraudes."

